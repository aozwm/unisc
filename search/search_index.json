{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#unisc-diploma","title":"\u6fb3\u5927\u5229\u4e9a\u9633\u5149\u6d77\u5cb8\u5927\u5b66\u6bd5\u4e1a\u8bc1\u6a21\u7248\uff08UniSC diploma\uff09\u5c55\u793a\u6bd4\u5bf9","text":"<p>\u5728\u5f53\u4e0b\u5168\u7403\u9ad8\u7b49\u6559\u80b2\u56fd\u9645\u5316\u3001\u6570\u5b57\u5316\u7684\u53cc\u91cd\u6f14\u8fdb\u4e0b\uff0c\u5982\u4f55\u51c6\u786e\u8bc6\u522b\u6d77\u5916\u9ad8\u6821\u7684\u5b98\u65b9\u5b66\u5386\u51ed\u8bc1\uff0c\u6210\u4e3a\u65e0\u6570\u6d77\u5916\u5f52\u56fd\u7559\u5b66\u751f\u3001\u8de8\u56fd\u4f01\u4e1a HR \u4ee5\u53ca\u5b66\u672f\u8ba4\u8bc1\u673a\u6784\u5171\u540c\u5173\u6ce8\u7684\u6838\u5fc3\u8bfe\u9898\u3002\u4f5c\u4e3a\u5750\u843d\u4e8e\u6606\u58eb\u5170\u5dde\u7684\u6fb3\u6d32\u65b0\u664b\u540d\u6821\uff0c\u6fb3\u5927\u5229\u4e9a\u9633\u5149\u6d77\u5cb8\u5927\u5b66\uff08University of the Sunshine Coast\uff0c\u7b80\u79f0 UniSC\uff0c\u66fe\u7528\u7b80\u79f0 USC\uff09\u51ed\u501f\u5176\u5353\u8d8a\u7684\u6559\u5b66\u8d28\u91cf\u548c\u73b0\u4ee3\u5316\u6821\u56ed\uff0c\u5438\u5f15\u4e86\u5927\u91cf\u56fd\u9645\u5b66\u751f\u3002</p> <p></p> <p>\u56fe\u7247\u6765\u6e90\u58f0\u660e\uff1a\u8be5\u56fe\u6e90\u81ea https://www.cererfi.com/auzhou/54.html \u672a\u7ecf\u6388\u6743\u7981\u6b62\u7528\u4e8e\u5546\u4e1a\u7528\u9014\u3002</p> <p>\u672c\u6587\u5c06\u56f4\u7ed5\u6fb3\u5927\u5229\u4e9a\u9633\u5149\u6d77\u5cb8\u5927\u5b66\u6bd5\u4e1a\u8bc1\u6a21\u7248\uff0c\u901a\u8fc7\u5bf9\u5b98\u65b9\u539f\u7248\u6837\u5f0f\u7684\u591a\u7ef4\u5ea6\u5c55\u793a\u4e0e\u6df1\u5ea6\u7ec6\u8282\u6bd4\u5bf9\uff0c\u5e2e\u52a9\u5927\u5bb6\u5168\u65b9\u4f4d\u89e3\u6790\u8fd9\u4efd\u9ad8\u542b\u91d1\u91cf\u8bc1\u4e66\u7684\u201c\u9632\u4f2a\u5bc6\u7801\u201d\u4e0e\u7248\u9762\u7f8e\u5b66\u3002</p>"},{"location":"#unisc","title":"\u4e00\u3001UniSC \u9633\u5149\u6d77\u5cb8\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\u5b98\u65b9\u57fa\u7840\u89c4\u8303","text":"<p>\u9633\u5149\u6d77\u5cb8\u5927\u5b66\u7684\u7eb8\u8d28\u5b66\u4f4d\u8bc1\u4e66\uff08Testamur / Diploma Certificate\uff09\u4e0d\u4ec5\u662f\u4e00\u4efd\u5b66\u5386\u51ed\u8bc1\uff0c\u66f4\u662f\u4e25\u683c\u9075\u5faa\u6fb3\u5927\u5229\u4e9a\u5b66\u5386\u8d44\u683c\u6846\u67b6\uff08AQF\uff09\u89c4\u8303\u7684\u6807\u51c6\u6cd5\u5f8b\u6587\u4ef6\u3002</p>"},{"location":"#1","title":"1. \u6750\u8d28\u4e0e\u7269\u7406\u89c4\u683c","text":"<ul> <li>\u5c3a\u5bf8\u6807\u51c6\uff1aUniSC \u6bd5\u4e1a\u8bc1\u7edf\u4e00\u91c7\u7528\u6807\u51c6\u7684 A4 \u5c3a\u5bf8\uff08210mm \u00d7 297mm\uff09\uff0c\u53ef\u9002\u914d\u5b98\u65b9\u63a8\u8350\u7684\u5404\u79cd\u7acb\u5f0f\u6216\u6a2a\u5f0f\u4e13\u7528\u4fdd\u62a4\u6846\u3002</li> <li>\u7eb8\u5f20\u9009\u6750\uff1a\u8bc1\u4e66\u9009\u7528\u9ad8\u514b\u91cd\u7684\u8c61\u7259\u767d / \u67d4\u767d\u8272\u7279\u79cd\u9632\u4f2a\u7eb8\u5f20\u3002\u8fd9\u79cd\u7eb8\u5f20\u5728\u81ea\u7136\u5149\u4e0b\u5448\u73b0\u7ec6\u817b\u7684\u54d1\u5149\u8d28\u611f\uff0c\u89e6\u624b\u6709\u660e\u663e\u7684\u8d28\u611f\u6c89\u6dc0\uff0c\u4e14\u5177\u5907\u6781\u5f3a\u7684\u9632\u6297\u76b1\u3001\u9632\u892a\u8272\u6027\u80fd\uff0c\u4fbf\u4e8e\u957f\u671f\u59a5\u5584\u4fdd\u5b58\u3002</li> </ul>"},{"location":"#unisc_1","title":"\u4e8c\u3001UniSC \u6bd5\u4e1a\u8bc1\u6a21\u7248\u6838\u5fc3\u89c6\u89c9\u677f\u5757\u6df1\u5ea6\u89e3\u6790","text":"<p>\u7ed3\u5408\u6700\u65b0\u7684\u5b98\u65b9\u5c55\u793a\u6837\u677f\uff0cUniSC \u7684\u5b66\u4f4d\u8bc1\u4e66\u7248\u9762\u6784\u56fe\u5448\u73b0\u51fa\u4e00\u79cd\u6781\u7b80\u3001\u73b0\u4ee3\u5374\u53c8\u4e0d\u5931\u5e84\u91cd\u7684\u6fb3\u6d32\u7f8e\u5b66\u98ce\u683c\u3002</p> <pre><code>+--------------------------------------------+\n\n|                  [ \u5b98\u65b9 Logo ]              |\n|          University of the Sunshine Coast  |\n|                     Australia              |\n|                                            |\n|                [ \u6bd5\u4e1a\u751f\u59d3\u540d ]              |\n|                                            |\n|            [ \u6388\u4e88\u5b66\u4f4d / \u6838\u5fc3\u4e13\u4e1a ]         |\n|              Bachelor of Nutrition         |\n|                                            |\n|               [ \u94a2\u5370 / \u5b98\u65b9\u5927\u5370 ]          |\n|             (UNIVERSITY OF THE SUNSHINE COAST) |\n|                                            |\n| [\u6821\u957f\u7b7e\u540d]                      [\u6821\u8463\u7b7e\u540d] |\n+--------------------------------------------+\n</code></pre>"},{"location":"#1-unisc-logo","title":"1. \u9876\u90e8\uff1aUniSC \u65b0\u7248\u5b98\u65b9\u5fbd\u6807\uff08Logo\uff09","text":"<p>\u8bc1\u4e66\u7684\u6700\u4e0a\u65b9\u6b63\u4e2d\uff0c\u9192\u76ee\u5370\u5237\u7740\u9633\u5149\u6d77\u5cb8\u5927\u5b66\u7684\u6807\u5fd7\u6027\u54c1\u724c\u89c6\u89c9\u3002\u5176\u8bbe\u8ba1\u7531\u84dd\u3001\u9ec4\u53cc\u8272\u4ea4\u7ec7\u7684\u51e0\u4f55\u9633\u5149\u5c04\u7ebf\u56fe\u6848\u7ec4\u6210\uff0c\u4ee3\u8868\u7740\u6606\u58eb\u5170\u201c\u9633\u5149\u4e4b\u5dde\u201d\u7684\u5730\u57df\u6d3b\u529b\u4e0e\u5b66\u672f\u521d\u5347\u7684\u671d\u6c14\u3002 \u4e0b\u65b9\u7d27\u968f\u4e24\u884c\u6807\u51c6\u886c\u7ebf\u5b57\u4f53\uff1a * University of the Sunshine Coast * Australia</p>"},{"location":"#2","title":"2. \u4e2d\u90e8\uff1a\u4e2a\u4eba\u4fe1\u606f\u4e0e\u5b66\u4f4d\u7ec6\u8282","text":"<p>\u5728\u201chaving fulfilled the conditions prescribed by the University...\u201d\uff08\u6ee1\u8db3\u5927\u5b66\u89c4\u5b9a\u7684\u6240\u6709\u6761\u4ef6\uff09\u8fd9\u884c\u7ecf\u5178\u53d9\u8ff0\u8bed\u4e4b\u4e0b\uff0c\u662f\u8bc1\u4e66\u7684\u6838\u5fc3\u53d8\u91cf\u4fe1\u606f\uff1a * \u6bd5\u4e1a\u751f\u59d3\u540d\uff1a\u91c7\u7528\u52a0\u7c97\u7684\u65e0\u886c\u7ebf\u73b0\u4ee3\u9ed1\u4f53\uff0c\u6e05\u6670\u6613\u8bfb\u3002 * \u6388\u4e88\u5b66\u4f4d\u540d\u79f0\uff1a\u5982\u56fe\u50cf\u6a21\u7248\u6240\u793a\u7684 \"Bachelor of Nutrition\"\uff08\u8425\u517b\u5b66\u5b66\u58eb\uff09\u6216 \"Bachelor of Health Science\"\uff08\u5065\u5eb7\u79d1\u5b66\u5b66\u58eb\uff09\u7b49\u3002\u5b66\u4f4d\u540d\u79f0\u7684\u5b57\u53f7\u901a\u5e38\u4e3a\u5168\u7248\u6700\u5927\uff0c\u4ee5\u6b64\u51f8\u663e\u6838\u5fc3\u5b66\u672f\u6210\u5c31\u3002</p>"},{"location":"#3","title":"3. \u5e95\u90e8\uff1a\u5b98\u65b9\u7b7e\u7ae0\u4e0e\u8bae\u4f1a\u6388\u6743","text":"<p>\u8bc1\u4e66\u4e0b\u534a\u90e8\u5206\u5305\u542b\u4e86\u8d4b\u4e88\u8be5\u8bc1\u4e66\u6cd5\u5f8b\u6548\u529b\u7684\u5173\u952e\u8981\u7d20\uff1a * \u6388\u4e88\u65e5\u671f\uff1a\u660e\u786e\u6807\u6ce8\u5177\u4f53\u7684\u9881\u53d1\u65e5\u671f\u4e0e\u5e74\u4efd\uff08\u4f8b\u5982\uff1atenth day of April 2024\uff09\u3002 * \u94a2\u5370\uff08Seal\uff09\uff1a\u4f4d\u4e8e\u4e0b\u65b9\u7684\u6b63\u4e2d\u592e\uff0c\u4e3a\u5706\u5f62\u9f7f\u8f6e\u72b6\u51f9\u51f8\u94a2\u5370\uff0c\u5916\u5708\u6e05\u6670\u73af\u7ed5\u7740 \u201cUNIVERSITY OF THE SUNSHINE COAST \u2022 QUEENSLAND, AUSTRALIA\u201d \u5b57\u6837\u3002 * \u9ad8\u5c42\u7b7e\u5b57\uff1a\u5de6\u4e0b\u89d2\u548c\u53f3\u4e0b\u89d2\u5206\u522b\u7531\u5927\u5b66\u7684\u9996\u5e2d\u884c\u653f\u957f\u5b98\uff08\u5982 Chancellor \u8bae\u957f\uff09\u548c\u6821\u957f\uff08Vice-Chancellor and President\uff09\u8fdb\u884c\u5b98\u65b9\u8054\u540d\u7b7e\u7f72\u3002</p>"},{"location":"#_1","title":"\u4e09\u3001\u6fb3\u6d32\u9633\u5149\u6d77\u5cb8\u5927\u5b66\u65b0\u8001\u7248\u8bc1\u4e66\u6a21\u7248\u5c55\u793a\u6bd4\u5bf9","text":"<p>\u4e0d\u5c11\u4eba\u5728\u63a5\u89e6 UniSC \u6bd5\u4e1a\u8bc1\u65f6\u4f1a\u4ea7\u751f\u7591\u95ee\uff1a\u4e3a\u4ec0\u4e48\u6709\u4e9b\u8bc1\u4e66\u4e0a\u5370\u7740 \u201cUSC\u201d\uff0c\u6709\u4e9b\u5219\u662f \u201cUniSC\u201d\uff1f\u8fd9\u5c31\u6d89\u53ca\u5230\u5b66\u6821\u5728\u8fd1\u5e74\u8fdb\u884c\u7684\u54c1\u724c\u5168\u9762\u5347\u7ea7\u3002</p> \u6bd4\u5bf9\u7ef4\u5ea6 \u8001\u7248\u6a21\u7248\u6837\u5f0f\uff08\u65e7\u79f0 USC\uff09 \u65b0\u7248\u6a21\u7248\u6837\u5f0f\uff08\u73b0\u79f0 UniSC\uff09 \u5b66\u6821\u7b80\u79f0 \u7edf\u4e00\u4f7f\u7528 USC \u7b80\u79f0\u3002 \u5168\u9762\u5347\u7ea7\u4e3a UniSC\uff08\u4ee5\u533a\u522b\u4e8e\u7f8e\u56fd\u5357\u52a0\u5dde\u5927\u5b66\u7b49\u9662\u6821\uff09\u3002 \u9876\u90e8\u5fbd\u6807 \u56fe\u6848\u76f8\u540c\uff0c\u4f46\u4e0b\u65b9\u7684\u6587\u5b57\u6392\u7248\u548c\u5b57\u4f53\u66f4\u504f\u5411\u65e9\u671f\u7684\u4f20\u7edf\u886c\u7ebf\u4f53\u3002 \u91c7\u7528\u4e86\u66f4\u4e3a\u73b0\u4ee3\u3001\u9ad8\u6e05\u6670\u5ea6\u7684\u8272\u5f69\u89c4\u8303\u4e0e\u5229\u843d\u7684\u73b0\u4ee3\u5316\u65e0\u886c\u7ebf\u5b57\u4f53\u3002 \u9632\u4f2a\u94a2\u5370 \u94a2\u5370\u591a\u5448\u94f6\u8272\u6216\u65e0\u8272\u51f9\u51f8\u611f\uff0c\u538b\u5370\u8fb9\u7f18\u8f83\u4f20\u7edf\u3002 \u91c7\u7528\u4e86\u66f4\u7cbe\u5bc6\u7684\u6fc0\u5149\u5b9a\u4f4d\u538b\u5370\u6280\u672f\uff0c\u9f7f\u8f6e\u7eb9\u8def\u4e0e\u5185\u90e8\u6587\u5b57\u5728\u653e\u5927\u955c\u4e0b\u8fb9\u7f18\u6781\u5ea6\u6e05\u6670\u3002 \u6570\u5b57\u5316\u652f\u6301 \u4e3b\u8981\u4ee5\u4f20\u7edf\u7eb8\u8d28\u8bc1\u4e66\u4e3a\u4e3b\uff0c\u914d\u5957\u7535\u5b50\u6210\u7ee9\u5355\u3002 \u539f\u7248\u7eb8\u8d28\u8bc1\u4e66\u5b8c\u7f8e\u8854\u63a5 My eQuals \u6570\u5b57\u5316\u5e73\u53f0\uff0c\u652f\u6301\u751f\u6210\u5e26\u5b98\u65b9\u52a0\u5bc6\u903b\u8f91\u7684 eDiploma\u3002"},{"location":"#unisc_2","title":"\u56db\u3001\u5982\u4f55\u5feb\u901f\u8fa8\u522b UniSC \u6bd5\u4e1a\u8bc1\u4e66\u7684\u771f\u4f2a\uff1f","text":"<p>\u5bf9\u4e8e\u7528\u4eba\u5355\u4f4d\u6216\u76f8\u5173\u5ba1\u67e5\u4eba\u5458\u6765\u8bf4\uff0c\u638c\u63e1\u4e00\u4e24\u9879\u884c\u4e4b\u6709\u6548\u7684\u9632\u4f2a\u8fa8\u522b\u6280\u5de7\u81f3\u5173\u91cd\u8981\uff1a</p> <ol> <li>\u89c2\u5bdf\u7eb8\u5f20\u900f\u5149\u5ea6\u4e0e\u5e95\u7eb9\uff1a\u771f\u6b63\u7684 UniSC \u6bd5\u4e1a\u8bc1\u5728\u7279\u5b9a\u5149\u7ebf\u89d2\u5ea6\u4e0b\uff0c\u80fd\u770b\u5230\u6781\u5176\u5fae\u5f31\u4e14\u89c4\u5f8b\u7684\u6821\u56ed\u9632\u4f2a\u5b89\u5168\u5e95\u7eb9\u6216\u9690\u5f62\u7279\u79cd\u5370\u5237\u7ebf\u6761\uff0c\u590d\u5370\u4ef6\u5219\u6781\u6613\u51fa\u73b0\u6a21\u7cca\u6216\u8272\u5f69\u65ad\u5c42\u3002</li> <li>\u89e6\u6478\u94a2\u5370\u7684\u7acb\u4f53\u89e6\u611f\uff1a\u7528\u624b\u629a\u6478\u8bc1\u4e66\u5e95\u90e8\u7684\u5706\u5f62\u5927\u5370\uff0c\u6b63\u53cd\u9762\u5747\u6709\u660e\u663e\u7684\u5747\u5300\u51f9\u51f8\u9519\u843d\u611f\u3002\u673a\u5668\u7c97\u7cd9\u4eff\u5236\u54c1\u7684\u94a2\u5370\u5f80\u5f80\u529b\u9053\u4e0d\u5747\uff0c\u751a\u81f3\u5bfc\u81f4\u7eb8\u5f20\u5468\u8fb9\u7684\u7ea4\u7ef4\u7834\u635f\u3002</li> <li>\u6838\u5bf9\u6821\u957f\u7b7e\u540d\u65f6\u6548\uff1a\u6bcf\u4e00\u65f6\u671f\u7684\u6bd5\u4e1a\u8bc1\uff0c\u5176\u4e0b\u65b9\u7684 Chancellor \u548c Vice-Chancellor \u7b7e\u540d\u5fc5\u987b\u4e0e\u5b98\u65b9\u5f53\u5e74\u5728\u4efb\u7684\u9886\u5bfc\u4eba\u5b8c\u5168\u543b\u5408\uff08\u4f8b\u5982\u56fe\u793a\u7248\u5757\u4e2d\u7b7e\u7f72\u7684 Air Chief Marshal Sir Angus Houston \u4e0e Professor Helen Bartlett\uff09\u3002</li> </ol>"},{"location":"#_2","title":"\u4e94\u3001\u7ed3\u8bed","text":"<p>\u6fb3\u5927\u5229\u4e9a\u9633\u5149\u6d77\u5cb8\u5927\u5b66\u6bd5\u4e1a\u8bc1\u6a21\u7248\u4e0d\u4ec5\u51dd\u805a\u4e86\u5b66\u5b50\u6570\u5e74\u5982\u4e00\u65e5\u7684\u5bd2\u7a97\u82e6\u8bfb\uff0c\u4e5f\u5c55\u73b0\u4e86\u8be5\u6821\u4e25\u8c28\u7684\u5b66\u672f\u89c4\u8303\u3002\u901a\u8fc7\u4e0a\u8ff0\u5bf9\u6750\u8d28\u3001\u6392\u7248\u3001\u65b0\u65e7\u7248\u672c\u6f14\u53d8\u4ee5\u53ca\u6838\u5fc3\u9632\u4f2a\u7279\u5f81\u7684\u5c55\u793a\u4e0e\u6bd4\u5bf9\uff0c\u76f8\u4fe1\u5927\u5bb6\u5bf9 UniSC \u5b66\u4f4d\u8bc1\u4e66\u6709\u4e86\u66f4\u6df1\u523b\u3001\u66f4\u76f4\u89c2\u7684\u4e86\u89e3\u3002</p> <p>\u968f\u7740\u6570\u5b57\u5316\u6d6a\u6f6e\u7684\u63a8\u8fdb\uff0c\u5efa\u8bae\u5e7f\u5927\u6821\u53cb\u5728\u59a5\u5584\u4fdd\u7ba1\u7eb8\u8d28\u539f\u7248\u8bc1\u4e66\u7684\u540c\u65f6\uff0c\u79ef\u6781\u5f00\u901a\u5e76\u5229\u7528\u6fb3\u6d32\u9ad8\u6821\u5b98\u65b9\u7684 My eQuals \u7535\u5b50\u8ba4\u8bc1\u6e20\u9053\uff0c\u53cc\u7ba1\u9f50\u4e0b\uff0c\u786e\u4fdd\u81ea\u8eab\u5b66\u672f\u6210\u679c\u7684\u771f\u5b9e\u6027\u4e0e\u56fd\u9645\u6d41\u901a\u6027\u3002\u5e1c\uff0c\u5c55\u73b0\u4e86\u6781\u9ad8\u7684\u6392\u7248\u7f8e\u5b66\u4ef7\u503c\u3002\u5bf9\u4e8e\u5e7f\u5927\u5b66\u5b50\u800c\u8a00\uff0c\u8fd9\u4efd\u8bc1\u4e66\u4e0d\u4ec5\u662f\u4e00\u5f20\u7cbe\u7f8e\u7684\u6392\u7248\u7eb8\u5f20\uff0c\u66f4\u662f\u6570\u5e74\u6311\u706f\u591c\u6218\u3001\u8de8\u6587\u5316\u5b66\u672f\u63a2\u7d22\u7684\u6c57\u6c34\u7ed3\u6676\u3002\u4e86\u89e3\u5176\u6392\u7248\u89c4\u8303\uff0c\u80fd\u8ba9\u6211\u4eec\u66f4\u6df1\u523b\u5730\u611f\u53d7\u5230\u5b66\u672f\u7684\u4e25\u8c28\u4e0e\u5c0a\u4e25\u3002\u771f\u5b9e\u6027\u7684\u6700\u7a33\u59a5\u65b9\u6848\u3002\u6bd4\u5bf9\u548c\u6210\u679c\u5c55\u793a\u65f6\u63d0\u4f9b\u6e05\u6670\u3001\u53ef\u9760\u7684\u89c6\u89c9\u4e0e\u903b\u8f91\u4f9d\u636e\u3002</p>"}]}